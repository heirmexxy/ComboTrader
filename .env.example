# ---- Required in production ----
NODE_ENV=production
BASE_URL=https://www.combotrader.com.ng
# e.g. openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string
PORT=3000
DATABASE_FILE=data/combotrader.db
UPLOADS_DIR=data/uploads

# ---- Paystack (leave blank locally for DEMO mode) ----
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
# Set the webhook URL in the Paystack dashboard to: https://www.combotrader.com.ng/webhooks/paystack

# ---- Email (Resend or Brevo) ----
# resend | brevo
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=ComboTrader <hello@combotrader.com.ng>

# ---- SMS / WhatsApp (Termii) ----
TERMII_API_KEY=
TERMII_SENDER_ID=ComboTrader

# ---- Live chat (tawk.to: Administration → Channels → Chat Widget → Direct chat link) ----
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=default
# optional: enables secure mode (verified visitor identity)
TAWK_API_KEY=

# ---- Google sign-in (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorised redirect URI: https://www.combotrader.com.ng/auth/google/callback

# ---- Push alerts (generate with: node dist/cli.mjs vapid) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@combotrader.com.ng

# ---- AI agents (optional; without a key the agents draft rule-based suggestions) ----
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# treasury, risk, growth and ops agents
AI_MODEL=claude-sonnet-5-5
# support and onboarding agents
AI_MODEL_FAST=claude-haiku-5-5

# ---- WhatsApp companion (Meta WhatsApp Cloud API; optional) ----
# permanent system-user access token
WHATSAPP_TOKEN=
# from WhatsApp Manager → API setup
WHATSAPP_PHONE_NUMBER_ID=
# any long random string; paste the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret (checks webhook signatures)
WHATSAPP_APP_SECRET=
# public number Champions message, digits only, e.g. 2348012345678
WHATSAPP_NUMBER=
# Webhook URL to give Meta: https://www.combotrader.com.ng/webhooks/whatsapp (subscribe to "messages")

# ---- Machine endpoints (cron jobs, eProcure price push) ----
CRON_SECRET=change-me

# ---- Social links ----
SOCIAL_X=https://x.com/KitovuT
SOCIAL_FACEBOOK=https://www.facebook.com/KitovuT
SOCIAL_LINKEDIN=https://www.linkedin.com/company/kitovu
SOCIAL_INSTAGRAM=https://www.instagram.com/combotrader

# ---- Behaviour ----
# admins must turn on two-step verification
ADMIN_REQUIRE_2FA=true
# in-process scheduler (prices 06:00, nudges 09:00, reconciliation 02:00 Lagos)
RUN_SCHEDULER=true
# never true on the live site
DEMO_MODE=false
# 127.0.0.1 = only reachable through the web server on this machine (set by deploy/setup.sh)
HOST_BIND=127.0.0.1
